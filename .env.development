NODE_ENV=development
LOG_LEVEL=debug

# Arcjet (example placeholder; replace with your real key locally, DO NOT commit real secrets)
ARCJET_KEY=ARCJET_KEY=ajkey_01ke8t2ebafnyrzb1za5c9mc6t
